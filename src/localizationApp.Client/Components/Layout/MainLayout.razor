@inherits LayoutComponentBase
@inject TranslationService Trad

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4">
            <CultureSelector />
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">@Trad.Global.Navigation["About"]</a>
        </div>
        <article class="content px-4">
            @Body
        </article>
        <footer class="text-center text-muted py-2 border-top mt-3">
            v@(System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "1.0.0")
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>